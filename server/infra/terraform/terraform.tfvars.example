project_id                = "ghapp-demo"
region                    = "us-central1"
container_image           = "us-docker.pkg.dev/ghapp-demo/control-plane/control-plane-server:latest"
base_url                  = "https://ghapp-control-plane-xxxxx-uc.a.run.app"

# Optional bootstrap values (set when GitHub integration is ready)
github_client_id          = ""
github_client_secret      = ""
github_app_id             = ""
github_app_slug           = "ghapp-demo-app"
github_app_private_key    = ""
github_app_webhook_secret = ""

# Bump to force writing a new Secret Manager version for app secrets
app_secrets_version       = 1
